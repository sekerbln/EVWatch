---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('news');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { title, date, author, summary, tags, image, imageCredit, imageCreditUrl } = article.data;
const { Content } = await render(article);
---
<Base title={`${title} — EVwatch`} description={summary}>
  <article class="article-page">

    {image && (
      <img class="article-hero-img" src={image} alt={title} />
    )}
    {imageCredit && (
      <p class="image-credit">
        <a href={imageCreditUrl} target="_blank" rel="noopener">{imageCredit}</a>
      </p>
    )}

    <header class="article-header">
      <div class="article-meta">
        <span class="article-date">{date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        {tags?.map((tag) => <span class="news-tag">{tag}</span>)}
      </div>
      <h1>{title}</h1>
      <p class="article-summary">{summary}</p>
      {author && <p class="article-author">By {author}</p>}
    </header>

    <div class="article-body"><Content /></div>

    <footer class="article-footer"><a href="/news">← Back to News</a></footer>
  </article>
</Base>

<style>
.image-credit {
  font-size: 0.75rem;
  color: #999;
  text-align: right;
  margin: 0.4rem 0 1.5rem;
}
.image-credit a {
  color: inherit;
  text-decoration: none;
}
.image-credit a:hover {
  text-decoration: underline;
}
.article-hero-img {
  width: 100%;
  height: 420px;
  object-fit: cover;
  display: block;
  margin-bottom: 2rem;
}
.article-page { max-width: 720px; margin: 0 auto; padding: 3rem 2rem 5rem; }
.article-header { margin-bottom: 3rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 2rem; }
.article-meta { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; }
.article-date { font-size: 0.85rem; color: #888; }
.news-tag { font-size: 0.75rem; background: #f0f0f0; padding: 2px 8px; text-transform: uppercase; letter-spacing: 0.05em; }
.article-page h1 { font-size: 2.2rem; line-height: 1.25; margin: 0 0 1rem; }
.article-summary { font-size: 1.15rem; color: #555; line-height: 1.6; margin-bottom: 0.75rem; }
.article-author { font-size: 0.85rem; color: #888; }
.article-body { line-height: 1.8; font-size: 1.05rem; color: #222; }
.article-body h2 { font-size: 1.4rem; margin: 2.5rem 0 1rem; }
.article-body p { margin-bottom: 1.25rem; }
.article-body ul, .article-body ol { padding-left: 1.5rem; margin-bottom: 1.25rem; }
.article-body li { margin-bottom: 0.4rem; }
.article-body strong { font-weight: 600; }
.article-body img {
  width: 100%;
  max-height: 400px;
  object-fit: cover;
  border-radius: 8px;
  margin: 1.5rem 0 0.5rem;
  display: block;
}
.article-body img + em {
  display: block;
  font-size: 0.8rem;
  color: #999;
  text-align: right;
  margin-bottom: 1.5rem;
}
.article-body a { color: inherit; border-bottom: 1px solid currentColor; }
.article-footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #e0e0e0; }
.article-footer a { font-size: 0.9rem; text-decoration: none; color: inherit; font-weight: 600; }
</style>
