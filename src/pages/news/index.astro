---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('news');
const sorted = articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="News — EVwatch" description="Latest news on China's EV industry in the GCC and global markets.">
  <section class="news-hero">
    <h1>News</h1>
    <p>China's EV industry, tracked for global markets.</p>
  </section>

  <section class="news-grid">
    {sorted.map((article) => (
      <article class="news-list-card">
        {article.data.image && (
          <a href={`/news/${article.id}`} class="news-thumb-box">
            <img src={article.data.image} alt={article.data.title} />
          </a>
        )}
        <div class="news-card-body">
          <div class="news-meta">
            <span class="news-date">{article.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            {article.data.tags?.map((tag) => <span class="news-tag">{tag}</span>)}
          </div>
          <h2><a href={`/news/${article.id}`}>{article.data.title}</a></h2>
          <p>{article.data.summary}</p>
          <a href={`/news/${article.id}`} class="read-more">Read more →</a>
        </div>
      </article>
    ))}
  </section>
</Base>

<style>
.news-hero { padding: 4rem 2rem 2rem; max-width: 900px; margin: 0 auto; }
.news-hero h1 { font-size: 3rem; margin-bottom: 0.5rem; }
.news-grid { max-width: 900px; margin: 0 auto; padding: 2rem; display: grid; gap: 2.5rem; }

.news-list-card {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 1.5rem;
  border-top: 1px solid #e0e0e0;
  padding-top: 2rem;
}
.news-thumb-box {
  display: block;
  overflow: hidden;
  border-radius: 8px;
}
.news-thumb-box img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  display: block;
  transition: transform 0.2s ease;
}
.news-thumb-box:hover img {
  transform: scale(1.04);
}

.news-meta { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; }
.news-date { font-size: 0.8rem; color: #888; }
.news-tag { font-size: 0.75rem; background: #f0f0f0; padding: 2px 8px; text-transform: uppercase; letter-spacing: 0.05em; }
.news-card h2 { font-size: 1.3rem; margin: 0.25rem 0 0.75rem; line-height: 1.3; }
.news-card h2 a { text-decoration: none; color: inherit; }
.news-card h2 a:hover { text-decoration: underline; }
.news-card p { color: #555; line-height: 1.6; margin-bottom: 1rem; }
.read-more { font-size: 0.9rem; font-weight: 600; text-decoration: none; color: inherit; border-bottom: 2px solid currentColor; padding-bottom: 1px; }

@media (max-width: 640px) {
  .news-list-card { grid-template-columns: 1fr; }
  .news-thumb-box img { height: 200px; }
}
</style>
