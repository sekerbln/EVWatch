---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('news');
const latest = articles
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<Base>
  <section class="hero">
    <h1>Tracking China's EV Industry,<br/>Connecting Global Markets</h1>
    <a href="/news" class="cta-btn">LATEST NEWS</a>
  </section>

  <section class="latest-news">
    <div class="section-header">
      <h2>Latest News</h2>
      <a href="/news">View all →</a>
    </div>
    <div class="latest-grid">
      {latest.map((article) => (
        <article class="latest-card">
          <div class="latest-meta">
            <span>{article.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          </div>
          <h3><a href={`/news/${article.id}`}>{article.data.title}</a></h3>
          <p>{article.data.summary}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
.hero { padding: 6rem 2rem; max-width: 900px; margin: 0 auto; }
.hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.15; margin-bottom: 2rem; }
.cta-btn { display: inline-block; padding: 0.75rem 2rem; border: 2px solid currentColor; text-decoration: none; font-weight: 600; letter-spacing: 0.08em; }
.cta-btn:hover { background: #000; color: #fff; }
.latest-news { max-width: 900px; margin: 0 auto; padding: 4rem 2rem; }
.section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem; border-bottom: 2px solid #000; padding-bottom: 0.75rem; }
.section-header h2 { margin: 0; }
.section-header a { font-size: 0.9rem; text-decoration: none; color: inherit; font-weight: 600; }
.latest-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
.latest-card { border-top: 1px solid #e0e0e0; padding-top: 1.25rem; }
.latest-meta { font-size: 0.8rem; color: #888; margin-bottom: 0.5rem; }
.latest-card h3 { font-size: 1rem; line-height: 1.4; margin-bottom: 0.5rem; }
.latest-card h3 a { text-decoration: none; color: inherit; }
.latest-card h3 a:hover { text-decoration: underline; }
.latest-card p { font-size: 0.9rem; color: #666; line-height: 1.5; }
</style>
